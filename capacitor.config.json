{
  "appId": "fr.kiosque.rss",
  "appName": "Kiosque",
  "webDir": "www",
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "BackgroundRunner": {
      "label": "fr.kiosque.check",
      "src": "runners/check.js",
      "event": "checkNews",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#13233d",
      "showSpinner": false
    }
  },
  "backgroundColor": "#13233d"
}
